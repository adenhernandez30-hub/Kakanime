<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#01050D"
                android:centerColor="#031127"
                android:endColor="#01040A" />
        </shape>
    </item>
    <item android:top="80dp" android:bottom="80dp" android:left="-180dp" android:right="-180dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="360dp"
                android:startColor="#0A3F83"
                android:centerColor="#05234D"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
