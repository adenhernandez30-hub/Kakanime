<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_reference_background"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/splashGlow"
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="center"
        android:background="@drawable/splash_reference_glow"
        android:alpha="0.78" />

    <ImageView
        android:id="@+id/splashImage"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/anilab_splash"
        android:alpha="0" />

    <LinearLayout
        android:id="@+id/splashBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="286dp"
        android:gravity="center"
        android:orientation="vertical"
        android:alpha="0">

        <TextView
            android:id="@+id/splashWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:text="AniLab"
            android:textColor="#EFFFFF"
            android:textSize="31sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/poppins"
            android:includeFontPadding="false"
            android:letterSpacing="0.18"
            android:text="ANIME • WATCH • DISCOVER"
            android:textColor="#86B8D6"
            android:textSize="9sp" />
    </LinearLayout>

    <View
        android:id="@+id/splashProgress"
        android:layout_width="180dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="392dp"
        android:background="@drawable/splash_reference_progress"
        android:scaleX="0"
        android:transformPivotX="0dp" />

</FrameLayout>