<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020817">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_ambient" />

    <ani.dantotsu.home.SplashEffectsView
        android:id="@+id/splashEffects"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/splashImage"
            android:layout_width="218dp"
            android:layout_height="218dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:alpha="0"
            android:scaleX="0.82"
            android:scaleY="0.82"
            android:src="@drawable/anilab_splash_logo" />

        <TextView
            android:id="@+id/splashName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/app_name"
            android:textColor="#F7FAFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:alpha="0"
            android:translationY="12dp" />

        <View
            android:id="@+id/splashDividerTop"
            android:layout_width="42dp"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#70DFFF"
            android:alpha="0" />

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/poppins"
            android:letterSpacing="0.22"
            android:text="MORE THAN JUST ANIME"
            android:textAllCaps="true"
            android:textColor="#D1DDF1"
            android:textSize="8sp"
            android:alpha="0"
            android:translationY="7dp" />

        <View
            android:id="@+id/splashDivider"
            android:layout_width="42dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#70DFFF"
            android:alpha="0" />

        <ProgressBar
            android:id="@+id/splashLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="132dp"
            android:layout_height="2dp"
            android:layout_marginTop="24dp"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            android:progressTint="#43CFFF"
            android:backgroundTint="#17365D"
            android:alpha="0" />

        <TextView
            android:id="@+id/splashLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:fontFamily="@font/poppins"
            android:text="Loading..."
            android:textColor="#AFC1DB"
            android:textSize="9sp"
            android:alpha="0" />

    </LinearLayout>
</FrameLayout>
