<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_reference_background"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/splashGlow"
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="center"
        android:background="@drawable/splash_reference_glow"
        android:alpha="0.35" />

    <View
        android:id="@+id/splashSweep"
        android:layout_width="320dp"
        android:layout_height="3dp"
        android:layout_gravity="center"
        android:background="@drawable/splash_reference_sweep"
        android:alpha="0"
        android:translationX="-180dp" />

    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/splashImage"
            android:layout_width="286dp"
            android:layout_height="286dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/anilab_splash"
            android:alpha="0" />

        <TextView
            android:id="@+id/splashWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:text="AniLab"
            android:textColor="#EFFFFF"
            android:textSize="31sp"
            android:textStyle="bold"
            android:alpha="0" />

        <View
            android:id="@+id/splashDivider"
            android:layout_width="96dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#3979B8"
            android:alpha="0" />

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/poppins"
            android:includeFontPadding="false"
            android:letterSpacing="0.16"
            android:text="MORE THAN JUST ANIME"
            android:textColor="#86B8D6"
            android:textSize="9sp"
            android:alpha="0" />

        <View
            android:id="@+id/splashProgress"
            android:layout_width="180dp"
            android:layout_height="4dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/splash_reference_progress"
            android:scaleX="0"
            android:transformPivotX="0dp" />

    </LinearLayout>

</FrameLayout>