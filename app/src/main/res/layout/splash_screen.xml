<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_reference_background"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/splashOrbit"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/splash_reference_orbit"
        android:alpha="0.7" />

    <View
        android:id="@+id/splashGlow"
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="center"
        android:background="@drawable/splash_reference_glow"
        android:alpha="0.72" />

    <ImageView
        android:id="@+id/splashImage"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/anilab_splash"
        android:alpha="0" />

    <TextView
        android:id="@+id/splashWordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="286dp"
        android:includeFontPadding="false"
        android:letterSpacing="0.04"
        android:text="AniLab"
        android:textColor="#EFFFFF"
        android:textSize="31sp"
        android:textStyle="bold"
        android:alpha="0" />

    <View
        android:id="@+id/splashSweep"
        android:layout_width="3dp"
        android:layout_height="250dp"
        android:layout_gravity="center"
        android:background="@drawable/splash_reference_sweep"
        android:rotation="-65"
        android:translationX="-360dp"
        android:alpha="0" />

    <View
        android:id="@+id/splashProgress"
        android:layout_width="180dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="390dp"
        android:background="@drawable/splash_reference_progress"
        android:scaleX="0"
        android:transformPivotX="0dp" />

</FrameLayout>