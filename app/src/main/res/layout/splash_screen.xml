<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030916">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_ambient" />

    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <ImageView
            android:id="@+id/splashImage"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:alpha="0"
            android:scaleX="0.72"
            android:scaleY="0.72"
            android:src="@drawable/anilab_launcher" />

        <TextView
            android:id="@+id/splashName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/app_name"
            android:textColor="#F4F8FF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:alpha="0"
            android:translationY="18dp" />

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins"
            android:letterSpacing="0.18"
            android:text="@string/slogan"
            android:textAllCaps="true"
            android:textColor="#C8D7F2"
            android:textSize="9sp"
            android:alpha="0"
            android:translationY="10dp" />

        <View
            android:id="@+id/splashDivider"
            android:layout_width="38dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#65DFFF"
            android:alpha="0" />

        <ProgressBar
            android:id="@+id/splashLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="128dp"
            android:layout_height="3dp"
            android:layout_marginTop="28dp"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            android:progressTint="#36C8FF"
            android:backgroundTint="#18304F"
            android:alpha="0" />

        <TextView
            android:id="@+id/splashLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins"
            android:text="Loading…"
            android:textColor="#9FB3D0"
            android:textSize="9sp"
            android:alpha="0" />

    </LinearLayout>
</FrameLayout>
