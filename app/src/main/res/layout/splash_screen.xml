<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020814">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_ambient" />

    <ani.dantotsu.home.SplashEffectsView
        android:id="@+id/splashEffects"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <ImageView
            android:id="@+id/splashImage"
            android:layout_width="158dp"
            android:layout_height="158dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:alpha="0"
            android:scaleX="0.76"
            android:scaleY="0.76"
            android:src="@drawable/anilab_splash_logo" />

        <TextView
            android:id="@+id/splashName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/app_name"
            android:textColor="#F4F8FF"
            android:textSize="31sp"
            android:textStyle="bold"
            android:alpha="0"
            android:translationY="16dp" />

        <View
            android:id="@+id/splashDividerTop"
            android:layout_width="28dp"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            android:background="#73DFFF"
            android:alpha="0" />

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins"
            android:letterSpacing="0.22"
            android:text="MORE THAN JUST ANIME"
            android:textAllCaps="true"
            android:textColor="#C9D8F0"
            android:textSize="8sp"
            android:alpha="0"
            android:translationY="8dp" />

        <View
            android:id="@+id/splashDivider"
            android:layout_width="28dp"
            android:layout_height="1dp"
            android:layout_marginTop="13dp"
            android:background="#73DFFF"
            android:alpha="0" />

        <ProgressBar
            android:id="@+id/splashLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="128dp"
            android:layout_height="2dp"
            android:layout_marginTop="25dp"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            android:progressTint="#39C9FF"
            android:backgroundTint="#18355A"
            android:alpha="0" />

        <TextView
            android:id="@+id/splashLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins"
            android:text="Loading..."
            android:textColor="#A6B8D3"
            android:textSize="9sp"
            android:alpha="0" />

    </LinearLayout>
</FrameLayout>
