<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="24dp">

    <ImageButton
        android:id="@+id/appIconBack"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/back"
        android:padding="14dp"
        android:src="@drawable/ic_round_arrow_back_ios_new_24"
        android:tint="?attr/colorOnBackground" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/poppins_bold"
        android:text="@string/app_icon"
        android:textColor="?attr/colorOnBackground"
        android:textSize="30sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:alpha="0.62"
        android:text="@string/app_icon_choose"
        android:textColor="?attr/colorOnBackground"
        android:textSize="14sp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/iconBlue"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="@color/nav_bg_inv"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_launcher_blue"
                android:contentDescription="@string/app_icon_blue" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="18dp"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/app_icon_blue"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/iconBlueCheck"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_round_check_24"
                android:tint="?attr/colorPrimary"
                android:visibility="gone"
                android:contentDescription="@string/selected" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/iconDark"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/nav_bg_inv"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_launcher_dark"
                android:contentDescription="@string/app_icon_dark" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="18dp"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/app_icon_dark"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/iconDarkCheck"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_round_check_24"
                android:tint="?attr/colorPrimary"
                android:visibility="gone"
                android:contentDescription="@string/selected" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/iconMono"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/nav_bg_inv"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_launcher_mono"
                android:contentDescription="@string/app_icon_mono" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="18dp"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/app_icon_mono"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/iconMonoCheck"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_round_check_24"
                android:tint="?attr/colorPrimary"
                android:visibility="gone"
                android:contentDescription="@string/selected" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
