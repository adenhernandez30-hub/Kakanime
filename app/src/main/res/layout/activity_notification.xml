<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/anilab_navy"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/notificationToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/anilab_navy">
        <ImageView
            android:id="@+id/notificationBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_round_arrow_back_ios_new_24"
            app:tint="@color/anilab_ice"
            tools:ignore="ContentDescription" />
        <TextView
            android:id="@+id/notificationTitle"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="60dp"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center|start"
            android:textColor="@color/anilab_text"
            android:textSize="20sp"
            tools:text="Social" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="67dp"
        android:background="@color/anilab_navy"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/notificationViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:nestedScrollingEnabled="true"
            tools:ignore="SpeakableTextPresentCheck" />
    </LinearLayout>

    <nl.joery.animatedbottombar.AnimatedBottomBar
        android:id="@+id/notificationNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginTop="-67dp"
        android:background="@drawable/anilab_bottom_nav"
        android:padding="0dp"
        app:abb_animationInterpolator="@anim/over_shoot"
        app:abb_indicatorAppearance="round"
        app:abb_indicatorColor="@color/anilab_cyan"
        app:abb_indicatorLocation="top"
        app:abb_indicatorMargin="28dp"
        app:abb_selectedTabType="text"
        app:abb_textAppearance="@style/NavBarText"
        app:itemActiveIndicatorStyle="@style/BottomNavBar"
        app:itemIconTint="@color/anilab_ice"
        app:itemRippleColor="#00000000"
        app:itemTextAppearanceActive="@style/NavBarText"
        app:itemTextAppearanceInactive="@style/NavBarText"
        app:itemTextColor="@color/anilab_muted" />
</LinearLayout>
